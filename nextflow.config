manifest {
    name = 'JIAJZHAN-Kairos/pdac-activedriverwgs-nf'
    version = '0.1.0'
    nextflowVersion = '>=24.10.0'
    description = 'Pinned ActiveDriverWGS tests scattered by element, followed by complete family-wide BH'
    mainScript = 'main.nf'
}
params {
    input = null
    outdir = null
    container = null
    mode = 'pilot'
    max_parallel = 64
    expected_fits = null
}
process {
    executor = 'awsbatch'
    container = params.container
    errorStrategy = 'terminate'
}
executor.queueSize = 64
aws.region = 'ap-southeast-2'
aws.batch.maxSpotAttempts = 3
profiles {
    local { process.executor = 'local'; docker.enabled = true }
    ci {
        process {
            executor = 'local'
            withName: FIT_BLOCK { memory = '1 GB' }
            withName: COLLECT_TESTS { memory = '1 GB' }
        }
        docker.enabled = false
    }
}
trace.enabled = true
report.enabled = true
timeline.enabled = true
